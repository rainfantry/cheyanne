# VADER Discord C2 — Environment Variables
# Copy to vader-rootkit/.env and fill in values

# Discord bot token (reuse mrrobot's or create a new bot)
DISCORD_BOT_TOKEN=

# Channel ID for C2 comms (create a private channel, right-click → Copy Channel ID)
DISCORD_C2_CHANNEL=

# Webhook URL for implant outbound (channel settings → Integrations → Webhooks → New)
DISCORD_C2_WEBHOOK=

# Ollama (optional, for AI brain)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Kimi (optional, for AI brain)
KIMI_API_KEY=
